# ---------------------------------------------------------------------------
# Lead Intelligence API configuration. Copy to .env and fill in the secrets.
# Every value is validated at startup; the process exits with a clear message
# listing anything missing or invalid.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Port the API listens on.
API_PORT=4000
# Allowed CORS origin(s) for the dashboard, comma separated.
WEB_ORIGIN=http://localhost:5173

# --- Data stores (docker compose up starts both) -----------------------------
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/lead-intelligence
# Redis URL used by the BullMQ analysis queue.
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------------
# Shared admin token. Every /api route (except /api/health) requires
# "Authorization: Bearer <token>". Use at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ACCESS_TOKEN=change-me-to-a-long-random-string

# --- Third-party API keys ------------------------------------------------------
# Google Places API (New) key, used for discovery (Phase 2). Restrict it to the
# Places API (New) in Google Cloud Console.
GOOGLE_PLACES_API_KEY=
# PageSpeed Insights API v5 key. Optional (keyless calls work but share a tiny
# quota); strongly recommended.
PAGESPEED_API_KEY=
# Anthropic API key for outreach drafts (Phase 4).
ANTHROPIC_API_KEY=

# --- Analysis queue ------------------------------------------------------------
# Number of analysis jobs processed in parallel.
ANALYSIS_CONCURRENCY=3
# Random politeness delay before each job starts, between MIN and MAX (ms).
# MIN also sets the global limiter: at most one job starts per MIN ms.
ANALYSIS_MIN_DELAY_MS=2000
ANALYSIS_MAX_DELAY_MS=5000
# Timeout for each HTTP request to a target website (ms).
REQUEST_TIMEOUT_MS=20000
# Retries after the first attempt (exponential backoff starting at 10s).
ANALYSIS_RETRIES=2
# Hard limit for one whole analysis job (ms).
ANALYSIS_JOB_TIMEOUT_MS=180000
# Run the worker inside the API process (true) or separately with
# "npm run dev:worker" / "npm run start:worker" (false).
RUN_WORKER_IN_API=true

# --- Google Places budget guard -------------------------------------------------
# Places calls are refused once either cap is reached (UTC day / UTC month).
PLACES_DAILY_REQUEST_CAP=200
PLACES_MONTHLY_REQUEST_CAP=3000

# --- PageSpeed ------------------------------------------------------------------
# Days to cache PageSpeed results per URL and strategy.
PAGESPEED_CACHE_DAYS=7
# Timeout for one PageSpeed run (ms). Lighthouse runs often take 15-60 s.
PAGESPEED_TIMEOUT_MS=90000

# --- Crawler identity and limits ----------------------------------------------------
# User agent sent to target sites. Its first token is matched against robots.txt.
# Put a real contact URL/email here.
CRAWLER_USER_AGENT=LeadIntelBot/0.1 (+https://example.com/bot; contact: you@example.com)
# Maximum HTML bytes read from a page (3 MB).
MAX_PAGE_BYTES=3145728

# --- Browser (Playwright / Chromium) ------------------------------------------------
# Disable to skip rendered inspection; chat and booking then stay "unknown".
BROWSER_ENABLED=true
# Max concurrent browser contexts sharing one Chromium instance.
BROWSER_POOL_SIZE=2
# Hard per-page navigation timeout (ms).
BROWSER_PAGE_TIMEOUT_MS=25000
# Optional path to a Chromium binary (otherwise Playwright's bundled browser).
PLAYWRIGHT_EXECUTABLE_PATH=
# Where screenshots are stored (served at /api/uploads behind auth).
UPLOADS_DIR=./uploads
